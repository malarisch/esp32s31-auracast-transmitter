# SPDX-License-Identifier: Apache-2.0
# Run the LC3 encoder from IRAM: its ~74 KB of code thrash the 16 KB I-cache when executed from flash.
[mapping:lc3_enc_iram]
archive: libesp_audio_codec.a
entries:
    esp_lc3_enc (noflash_text)
    lc3_attack_detector_fx (noflash_text)
    lc3_band_detector_fx (noflash_text)
    lc3_constant_fx (noflash_text)
    lc3_dct2 (noflash_text)
    lc3_enc (noflash_text)
    lc3_global_gain (noflash_text)
    lc3_ltpf (noflash_text)
    lc3_mdct (noflash_text)
    lc3_mem (noflash_text)
    lc3_nf_quant_gain (noflash_text)
    lc3_res_ari_bit (noflash_text)
    lc3_rsp_128_fx (noflash_text)
    lc3_sns_enc_fx (noflash_text)
    lc3_tns_enc_fx (noflash_text)
    lc3_attack_detector_hp_filter (noflash_text)
    lc3_band_detector_find_nyquest (noflash_text)
    lc3_cal_nf_seed (noflash_text)
    lc3_cal_nf_seed (noflash_text)
    lc3_fft_bf2 (noflash_text)
    lc3_fft_bf5 (noflash_text)
    lc3_find_max (noflash_text)
    lc3_find_max_val (noflash_text)
    lc3_global_gain_opt (noflash_text)
    lc3_hotspots (noflash_text)
    lc3_imdct_post_fft (noflash_text)
    lc3_imdct_pre_fft (noflash_text)
    lc3_loop_shift (noflash_text)
    lc3_macros (noflash_text)
    lc3_mdct_base (noflash_text)
    lc3_mdct_post_fft (noflash_text)
    lc3_mdct_pre_fft (noflash_text)
    lc3_mdct_windows_16 (noflash_text)
    lc3_rsp_dot16_32 (noflash_text)
    lc3_rsp_downsample_6_4 (noflash_text)
    lc3_rsp_max_abs16 (noflash_text)
    lc3_rsp_resample_12k8 (noflash_text)
    lc3_rsp_shift16 (noflash_text)
    lc3_sns_enc_band_energy (noflash_text)
    lc3_sns_enc_band_energy (noflash_text)
    lc3_sns_enc_smooth (noflash_text)
    lc3_tns_corr16_64 (noflash_text)
    lc3_util (noflash_text)
